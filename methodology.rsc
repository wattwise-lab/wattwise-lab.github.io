1:["$","main",null,{"children":[["$","header",null,{"className":"site-header subpage-header","children":[["$","$Ld",null,{"className":"brand","href":"/","aria-label":"Home Energy Cost Lab home","children":[["$","span",null,{"className":"brand-mark","children":["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z","key":"1v7up4"}]],"className":"lucide-zap","aria-hidden":"true"}]}],["$","span",null,{"children":["Home Energy ",["$","b",null,{"children":"Cost Lab"}]]}]]}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","$Ld",null,{"href":"/#calculator","children":"Electricity cost"}],["$","$Ld",null,{"href":"/solar-calculator","children":"Solar"}],["$","$Ld",null,{"href":"/battery-runtime-calculator","children":"Battery"}],["$","$Ld",null,{"href":"/ev-charging-cost-calculator","children":"EV charging"}]]}],["$","$Ld",null,{"className":"data-pill","href":"/methodology","children":[["$","span",null,{}]," Sources & method"]}]]}],["$","section",null,{"className":"text-page","children":[["$","span",null,{"className":"section-kicker","children":"METHODOLOGY"}],["$","h1",null,{"children":"Transparent inputs, visible formulas, dated sources."}],["$","p",null,{"className":"page-lede","children":"Our tools are designed to help a homeowner frame a decision—not to replace a utility tariff, installer quote, licensed design or tax advice."}],["$","div",null,{"className":"prose-grid","children":[["$","article",null,{"children":[["$","h2",null,{"children":"Data hierarchy"}],["$","p",null,{"children":"We prefer U.S. government datasets and national laboratories, followed by manufacturer specifications supplied by the user. Every default must be editable because public averages are not personal facts."}],["$","h2",null,{"children":"Electricity prices"}],["$","p",null,{"children":"The homepage uses EIA's 2024 State Electricity Profiles. Those figures are average retail prices across end-use sectors, not a guaranteed residential tariff. The calculator therefore lets the user replace the default with the cents-per-kWh value from a current bill."}],["$","h2",null,{"children":"Solar model"}],["$","p",null,{"children":"The simplified solar calculator derives consumption from bill and rate, then sizes production from peak-sun hours and system losses. NREL PVWatts remains the preferred next step for location-specific solar resource, roof orientation and more detailed loss modeling."}],["$","h2",null,{"children":"Battery model"}],["$","p",null,{"children":"Deliverable energy equals nameplate capacity after reserve and inverter efficiency. Runtime equals deliverable watt-hours divided by average watts. Startup surge, equipment limits and electrical-code requirements remain outside scope."}],["$","h2",null,{"children":"EV model"}],["$","p",null,{"children":"EV energy equals miles multiplied by kWh per 100 miles, adjusted for charging loss. Gasoline energy cost equals miles divided by MPG, multiplied by dollars per gallon."}],["$","h2",null,{"children":"Corrections"}],["$","p",null,{"children":"We date methodology reviews and correct formulas or source descriptions when new evidence warrants it. Contact us with the page, input values and expected result so the calculation can be reproduced."}]]}],["$","aside",null,{"className":"source-list","children":[["$","b",null,{"children":"Core sources"}],["$","a",null,{"href":"https://www.eia.gov/electricity/state/","target":"_blank","rel":"noreferrer","children":["EIA State Electricity Profiles ",["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link"}]]}],["$","a",null,{"href":"https://pvwatts.nrel.gov/","target":"_blank","rel":"noreferrer","children":["NREL PVWatts ",["$","$Le",null,{"ref":"$undefined","iconNode":"$1:props:children:1:props:children:3:props:children:1:props:children:1:props:children:1:props:iconNode","className":"lucide-external-link"}]]}],"$Lf","$L10","$L11"]}]]}]]}],"$L12"]}]
