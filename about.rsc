1:["$","main",null,{"children":[["$","$Le",null,{}],["$","section",null,{"className":"text-page narrow-page","children":[["$","span",null,{"className":"section-kicker","children":"ABOUT"}],["$","h1",null,{"children":"让每个人都能看懂数字。"}],["$","p",null,{"className":"page-lede","children":"CalcMintly 是一个全品类在线计算器项目，把常用公式做成快速、清晰、可检查的决策工具。"}],["$","article",null,{"children":[["$","h2",null,{"children":"我们做什么"}],["$","p",null,{"children":"每个页面围绕一个具体问题，提供实时计算、结果解释、公式和适用限制。工具不要求注册，首发版本也不上传用户输入。"}],["$","h2",null,{"children":"我们不做什么"}],["$","p",null,{"children":"我们不会用“AI”标签掩盖写死的规则，也不会把估算包装成确定结论。涉及金融、健康、税务和工程时，结果不能替代专业意见。"}],["$","h2",null,{"children":"扩展原则"}],["$","p",null,{"children":"新工具必须满足三个条件：输入可以获得、计算可以复核、输出可以行动。无法可靠量化的主题不会伪造成精确评分。"}]]}]]}],["$","$Lf",null,{}]]}]
